{
  "name": "restrainify",
  "private": true,
  "version": "0.0.0",
  "description": "Restrainify V1 Android-first local protection workspace.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "format": "prettier --check \"**/*.{css,js,json,ts,tsx}\"",
    "format:write": "prettier --write \"**/*.{css,js,json,ts,tsx}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.0",
    "@types/react": "19.1.13",
    "eslint": "10.0.1",
    "jest": "30.1.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
