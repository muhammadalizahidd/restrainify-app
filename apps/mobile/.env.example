# Google OAuth Web Client ID (from Google Cloud Console -> Web Application Client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Backend API URL:
# - Android Emulator accessing localhost on your computer: http://10.0.2.2:3000
# - Physical Android device over local Wi-Fi: http://<your-computer-ip>:3000
# - Production: https://restrainify.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
